{
    "framework": "vite",
    "buildCommand": "vite build",
    "outputDirectory": "dist",
    "rewrites": [
        { "source": "/privacy", "destination": "/privacy.html" },
        { "source": "/tentang", "destination": "/tentang.html" },
        { "source": "/(.*)", "destination": "/index.html" }
    ]
}
