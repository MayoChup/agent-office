# Kunci OpenRouter (boleh sama dengan yang dipakai Hermes).
# Kantor HANYA memakai model gratis (":free"), jadi saldo tidak terpotong.
OPENROUTER_API_KEY=

# Lokasi Hermes (biasanya tidak perlu diubah)
# HERMES_HOME=/home/kantor/.hermes

# Alamat server. Biarkan 127.0.0.1 supaya TIDAK terbuka ke internet.
# HOST=127.0.0.1
# PORT=3000

# Cadangan AI gratis kalau semua model OpenRouter sibuk (isi salah satu atau keduanya).
# Gemini: https://aistudio.google.com/apikey  (pakai proyek TANPA billing supaya tetap gratis)
GEMINI_API_KEY=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
